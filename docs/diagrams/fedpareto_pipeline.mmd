    E[Temporal reliability update]
    F[Benign subspace consistency]
    G[Pareto-aware weight optimizer]
    H[Weighted aggregation]
    I[Global evaluation and logging]

    A --> B --> C --> D
    D --> E
    D --> F
    E --> G
    F --> G
    G --> H --> I
